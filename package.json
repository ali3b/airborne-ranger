{
  "name": "solitary-strike",
  "version": "0.1.0",
  "description": "Solitary Strike: an isometric commando game in Phaser 3, with every sprite, tileset and map made by Synty Sprite Generator.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/build-assets.mjs",
    "check": "node scripts/load-check.mjs"
  },
  "dependencies": {
    "phaser": "3.80.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "1.48.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
